// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  // output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("HOSPITAL")   // HOSPITAL | CLINIC | etc.
  address     String?
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  patients    Patient[]

  @@index([isActive])
}

model User { 
  id                  Int     @id @default(autoincrement()) 
  email               String  @unique
  password            String
  name                String?
  role                UserRole @default(REVIEWER)
  reviews             PriorAuthReview[]

  // Relation to Organization
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([role])
}


model Patient {
  id              String   @id                     // e.g. PAT001
  name            String
  insurancePayer  String
  procedureCode   String
  procedureName   String
  diagnosisCode   String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  notes           ClinicalNote[]
  medications     MedicationRecord[]
  imagingReports  ImagingReport[]

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@index([organizationId])
  @@index([insurancePayer])
}

model ClinicalNote {
  id          String   @id @default(cuid())
  patientId   String
  documentId  String
  noteDate    String   // keep string if your mocks use "2026-02-01"
  bodyText    String
  sourceType  String   @default("EHR")
  createdAt   DateTime @default(now())

  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([documentId])
}

model MedicationRecord {
  id          String   @id @default(cuid())
  patientId   String
  documentId  String
  drugName    String
  category    String   // NSAID, Pain Medication, ...
  recordDate  String
  status      String   @default("active")
  createdAt   DateTime @default(now())

  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([category])
}

model ImagingReport {
  id          String   @id @default(cuid())
  patientId   String
  documentId  String
  bodyPart    String
  findings    String
  reportDate  String
  sourceType  String   @default("Imaging")
  createdAt   DateTime @default(now())

  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([bodyPart])
}

model PriorAuthReview {
  id                String   @id @default(cuid())
  patientId         String
  agentRecommendation String
  agentStatus       String
  finalDecision     String
  reviewerNote      String?
  agentResultJson   Json
  overridesJson     Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  reviewerId        Int?
  reviewer          User?    @relation(fields: [reviewerId], references: [id])
  @@index([patientId])
  @@index([createdAt])
}


model PolicyChunk {
  id          BigInt                 @id @default(autoincrement())
  content     String
  insurance   String?
  procedure   String?
  cptCodes    String?                @map("cpt_codes")
  sourceFile  String?                @map("source_file")
  metadata    Json?
  embedding   Unsupported("vector")?

  createdAt   DateTime               @default(now()) @map("created_at")

  @@map("policy_chunks")
  @@index([insurance])
  @@index([procedure])
}

enum UserRole {
  ADMIN
  REVIEWER
}