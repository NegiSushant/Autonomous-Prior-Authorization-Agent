// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id               Int                  @id @default(autoincrement())
  name             String
  type             OrgType              @default(DEMO)
  address          String?
  phone            String?
  email            String?
  isActive         Boolean              @default(true)
  createdBy        String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  users            User[]
  patients         Patient[]

  @@index([isActive])
}

model User { 
  id                Int                 @id @default(autoincrement()) 
  email             String              @unique
  password          String
  name              String?
  role              UserRole            @default(REVIEWER)
  reviews           PriorAuthReview[]
  organizationId    Int?
  organization      Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([organizationId])
  @@index([role])
}


model Patient {
  id                Int      @id @default(autoincrement())
  name              String
  email             String?
  insurancePayer    String
  procedureCode     String
  procedureName     String
  diagnosisCode     String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  organizationId    Int
  isProceed         Boolean?
  notes             ClinicalNote[]
  medications       MedicationRecord[]
  imagingReports    ImagingReport[]
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentResponse     AgentReviewResult[]
  
  @@index([organizationId])
  @@index([insurancePayer])
}

model ClinicalNote {
  id                Int                 @id @default(autoincrement())
  patientId         Int
  documentId        String
  noteDate          DateTime
  bodyText          String
  sourceType        String              @default("EHR")
  createdAt         DateTime            @default(now())
  patient           Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([documentId])
}

model MedicationRecord {
  id                Int                 @id @default(autoincrement())
  patientId         Int
  documentId        String
  drugName          String
  category          String 
  recordDate        DateTime
  status            String             @default("active")
  createdAt         DateTime           @default(now())
  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  @@index([patientId])
  @@index([category])
}

model ImagingReport {
  id                Int                 @id @default(autoincrement())
  patientId         Int
  documentId        String
  bodyPart          String
  findings          String
  reportDate        DateTime
  sourceType        String              @default("Imaging")
  createdAt         DateTime            @default(now())
  patient           Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  @@index([patientId])
  @@index([bodyPart])
}

model PriorAuthReview {
  id                Int   @id @default(autoincrement())
  patientId         Int
  agentRecommendation String
  agentStatus       String
  finalDecision     String
  reviewerNote      String?
  agentResultJson   Json
  overridesJson     Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  reviewerId        Int?
  reviewer          User?    @relation(fields: [reviewerId], references: [id])
  agentReviewResults AgentReviewResult[]

  @@index([patientId])
  @@index([createdAt])
}


model AgentReviewResult {
  id                  Int      @id @default(autoincrement())
  patientId           Int
  priorAuthReviewId   Int?
  recommendation      String
  status              String
  criteria            Json 
  executionTrace      Json
  gatheredEvidence    Json 
  rawResponse         Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  patient             Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  priorAuthReview     PriorAuthReview? @relation(fields: [priorAuthReviewId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([priorAuthReviewId])
  @@index([status])
  @@index([recommendation])
  @@index([createdAt])
}


model PolicyChunk {
  id          BigInt                 @id @default(autoincrement())
  content     String
  insurance   String?
  procedure   String?
  cptCodes    String?                @map("cpt_codes")
  sourceFile  String?                @map("source_file")
  metadata    Json?
  embedding   Unsupported("vector")?

  createdAt   DateTime               @default(now()) @map("created_at")

  @@map("policy_chunks")
  @@index([insurance])
  @@index([procedure])
}

enum UserRole {
  SUPERADMIN
  ADMIN
  REVIEWER
}

enum OrgType{
  DEMO
  HOSPITAL
  CLINIC
  OTHERS
}